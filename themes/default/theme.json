{
  "name": "Default",
  "version": "1.0",
  "description": "Clean, minimal white-label theme. Works for any product category.",
  "preview": "preview.png",
  "colors": {
    "primary": "#3BB77E",
    "primary-dark": "#2A9062",
    "primary-light": "#F4FCF7",
    "secondary": "#FDC040",
    "accent": "#FFA530",
    "surface": "#FFFFFF",
    "background": "#F8FAFB",
    "text-dark": "#253D4E",
    "text-muted": "#7E8D97",
    "text-light": "#AEBCC6",
    "border": "#E9F0F4",
    "success": "#3BB77E",
    "warning": "#FDC040",
    "danger": "#E11D48",
    "header-bg": "#FFFFFF",
    "header-text": "#253D4E",
    "footer-bg": "#17324A",
    "footer-text": "#DBE6EF",
    "badge-sale": "#E11D48",
    "badge-new": "#3BB77E"
  },
  "fonts": {
    "heading": "Quicksand",
    "body": "Inter",
    "mono": "monospace",
    "heading_weights": "600;700",
    "body_weights": "400;500;600;700",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
  },
  "spacing": {
    "section_padding": "72px 0",
    "card_radius": "12px",
    "button_radius": "8px",
    "input_radius": "8px",
    "container_max_width": "1280px"
  },
  "header": {
    "style": "standard",
    "sticky": true,
    "show_topbar": true,
    "topbar_bg": "#253D4E",
    "topbar_text": "#FFFFFF"
  },
  "footer": {
    "style": "columns",
    "columns": 4
  },
  "product_card": {
    "style": "standard",
    "show_wishlist": true,
    "show_rating": true,
    "show_add_to_cart": true,
    "image_aspect_ratio": "1/1"
  },
  "homepage_sections": {
    "hero": { "style": "split", "height": "560px" },
    "categories": { "style": "grid", "columns": 5 },
    "featured": { "style": "grid", "columns": 4 },
    "testimonials": { "style": "carousel" }
  }
}
