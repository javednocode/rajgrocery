{
  "name": "Raj Grocery",
  "version": "2.0",
  "description": "Raj Grocery Store — warm masala green and turmeric on an oat canvas. Values mirror the --raj-* tokens in styles.css so the runtime theme injection agrees with the stylesheet instead of overriding it.",
  "preview": "preview.png",
  "colors": {
    "primary": "#17513F",
    "primary-dark": "#0E3A2C",
    "primary-light": "#EBF3EF",
    "secondary": "#2F7D63",
    "accent": "#E4A33B",
    "surface": "#FFFFFF",
    "background": "#FAF7F1",
    "text-dark": "#211A14",
    "text-muted": "#6F6259",
    "text-light": "#8A7C6E",
    "border": "#E5DCCC",
    "success": "#17513F",
    "warning": "#E4A33B",
    "danger": "#C0392B",
    "header-bg": "#FFFFFF",
    "header-text": "#211A14",
    "footer-bg": "#14342A",
    "footer-text": "#D9E4DF",
    "badge-sale": "#C0392B",
    "badge-new": "#17513F"
  },
  "fonts": {
    "heading": "Fraunces",
    "body": "Manrope",
    "mono": "monospace",
    "heading_weights": "400..900",
    "body_weights": "400..800",
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Manrope:wght@400..800&display=swap"
  },
  "spacing": {
    "section_padding": "80px 0",
    "card_radius": "14px",
    "button_radius": "9999px",
    "input_radius": "10px",
    "container_max_width": "1360px"
  },
  "header": {
    "style": "standard",
    "sticky": true,
    "show_topbar": true,
    "topbar_bg": "#14342A",
    "topbar_text": "#FFFFFF"
  },
  "footer": {
    "style": "columns",
    "columns": 4
  },
  "product_card": {
    "style": "standard",
    "show_wishlist": true,
    "show_rating": true,
    "show_add_to_cart": true,
    "image_aspect_ratio": "1/1"
  },
  "homepage_sections": {
    "hero": { "style": "split", "height": "560px" },
    "categories": { "style": "grid", "columns": 5 },
    "featured": { "style": "grid", "columns": 4 },
    "testimonials": { "style": "carousel" }
  }
}
