# ─────────────────────────────────────────────────────────
# White-Label Ecommerce Engine — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ─────────────────────────────────────────────────────────

# Application
APP_ENV=production
APP_URL=https://yourdomain.com
APP_NAME=Your Store
APP_TIMEZONE=UTC
APP_LOCALE=en-US
APP_CURRENCY=USD
APP_CURRENCY_SYMBOL=$

# Site Branding (used as install defaults — override in Admin Settings)
SITE_NAME=Your Store
SITE_TAGLINE=Quality products delivered to your door.
SITE_EMAIL=hello@yourdomain.com

# Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=CHANGE_THIS_PASSWORD
DB_ROOT_PASS=CHANGE_THIS_ROOT_PASSWORD

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

# Media
MEDIA_URL=https://yourdomain.com

# Base path (if backend is in a subdirectory, e.g. /api)
BASE_PATH=
